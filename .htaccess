ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
DirectoryIndex index.html

RewriteEngine On

# HTTPS и без www
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^(.*)$ https://xn----7sbaagc0cqfsebjl5agg3t.xn--p1ai/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://xn----7sbaagc0cqfsebjl5agg3t.xn--p1ai/$1 [R=301,L]

# Старые адреса Tilda -> новые
RewriteRule ^page122115896\.html$ / [R=301,L]
RewriteRule ^obninsk/?$ / [R=301,L]
RewriteRule ^page144481676\.html$ /staff.html [R=301,L]
RewriteRule ^page129085556\.html$ /politica [R=301,L]
RewriteRule ^page129382986\.html$ /agreement [R=301,L]
RewriteRule ^page130050436\.html$ /offer [R=301,L]

# Красивые адреса
RewriteRule ^politica/?$ politica.html [L]
RewriteRule ^agreement/?$ agreement.html [L]
RewriteRule ^offer/?$ offer.html [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
